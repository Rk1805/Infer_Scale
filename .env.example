# InferScale Configuration
# Copy to .env and adjust for your environment

# Database
DB_URL=sqlite:///./experiments.db

# Simulator
SIMULATOR_STARTUP_DELAY=10
SIMULATOR_COOLDOWN=30
MIN_REPLICAS=1
MAX_REPLICAS=8
STARTUP_DELAY=10
COOLDOWN=30

# Policies
FIXED_CAPACITY=4
THRESHOLD_UPPER=0.75
THRESHOLD_LOWER=0.25
SCALING_IN_DURATION=60

# RL
PPO_EPISODE_BUDGET=200000
PPO_ALPHA=0.1
PPO_BETA=0.01
PPO_GAMMA=0.99

# API
API_HOST=0.0.0.0
API_PORT=8000

# Frontend
FRONTEND_API_BASE=/api
